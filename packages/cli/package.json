{
  "name": "@acrolls/cli",
  "version": "0.1.0",
  "description": "Acrolls CLI: init, integrate, validate, studio.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "acrolls": "./dist/index.js"
  },
  "files": [
    "dist",
    "studio-app",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean && node -e \"const fs=require('fs');const p='dist/index.js';fs.writeFileSync(p,'#!/usr/bin/env node\\n'+fs.readFileSync(p,'utf8'));fs.chmodSync(p,0o755)\"",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@acrolls/mdsvex": "workspace:*",
    "mdsvex": "^0.12.6",
    "svelte": "^5.38.1"
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "acrolls",
    "cli",
    "mdsvex",
    "sveltekit"
  ]
}
