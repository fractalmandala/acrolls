{
  "name": "@acrolls/docs",
  "version": "0.1.1",
  "description": "Docs shell templates for Acrolls: sidebar, collapsible nav, breadcrumbs, pager.",
  "license": "Apache-2.0",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "src",
    "styles.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "svelte-package -i src/lib -o dist && cp styles.css dist/styles.css 2>/dev/null; true",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.0",
    "svelte": "^5.38.1",
    "svelte-check": "^4.3.1",
    "typescript": "^5.9.2"
  },
  "keywords": [
    "acrolls",
    "docs",
    "sidebar",
    "svelte",
    "documentation"
  ]
}
